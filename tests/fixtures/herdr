#!/bin/sh
# Deterministic Herdr stand-in for behavior tests.
# Records every invocation and emulates worktree/agent lifecycle responses.
set -eu

log="${FIXTURE_LOG:?FIXTURE_LOG is required}"
state="${FIXTURE_STATE:?FIXTURE_STATE is required}"
printf 'herdr %s\n' "$*" >>"$log"

if [ "${1:-}" = "--session" ]; then
  shift 2
fi
command="${1:-}"
subcommand="${2:-}"

case "$command:$subcommand" in
  status:*)
    printf '{"result":{"server":"running"}}\n'
    ;;
  worktree:create)
    shift 2
    repo=""
    branch=""
    base=""
    path=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --cwd) repo="$2"; shift 2 ;;
        --branch) branch="$2"; shift 2 ;;
        --base) base="$2"; shift 2 ;;
        --path) path="$2"; shift 2 ;;
        --label) shift 2 ;;
        *) shift ;;
      esac
    done
    git -C "$repo" worktree add -b "$branch" "$path" "$base" >/dev/null 2>&1
    printf '%s\n' "$path" >>"$state/worktrees"
    printf '{"result":{"workspace":{"workspace_id":"w1"},"root_pane":{"pane_id":"w1:p1"}}}\n'
    ;;
  agent:start)
    printf '%s\n' "$3" >"$state/agent"
    printf '{"result":{"agent":{"name":"%s","state":"idle"}}}\n' "$3"
    ;;
  agent:prompt)
    printf '{"result":{"agent":{"state":"working"}}}\n'
    ;;
  agent:get)
    state_value="working"
    if [ -f "$state/agent_state" ]; then
      state_value="$(cat "$state/agent_state")"
    fi
    printf '{"result":{"agent":{"state":"%s"}}}\n' "$state_value"
    ;;
  *)
    printf 'unsupported herdr invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
