#!/bin/sh
# Deterministic AgentMail stand-in for behavior tests.
set -eu

log="${FIXTURE_LOG:?FIXTURE_LOG is required}"
state="${FIXTURE_STATE:?FIXTURE_STATE is required}"
printf 'agent-mail %s\n' "$*" >>"$log"

case "${1:-}" in
  send)
    shift
    recipient=""
    sender=""
    subject=""
    body=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --to) recipient="$2"; shift 2 ;;
        --from) sender="$2"; shift 2 ;;
        --subject) subject="$2"; shift 2 ;;
        --body) body="$2"; shift 2 ;;
        --reply-to) shift 2 ;;
        --json) shift ;;
        *) shift ;;
      esac
    done
    printf '%s\n' "$body" >"$state/handoff-body"
    printf '{"id":"MSG-HANDOFF","recipient":"%s","sender":"%s","subject":"%s","timestamp":"2026-01-01T00:00:00Z","mailbox":"%s","state":"delivered"}\n' \
      "$recipient" "$sender" "$subject" "$state"
    ;;
  scan)
    if [ -f "$state/report-header.json" ]; then
      cat "$state/report-header.json"
    else
      printf '[]\n'
    fi
    ;;
  read)
    if [ -f "$state/report-message" ]; then
      cat "$state/report-message"
    else
      printf 'no such message\n' >&2
      exit 1
    fi
    case "${3:-}" in
      --peek) ;;
      *) printf 'read\n' >>"$state/report-read" ;;
    esac
    ;;
  *)
    printf 'unsupported agent-mail invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
